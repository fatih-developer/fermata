<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Fermata.Desktop.Views.QuestionWindow"
        Width="460" SizeToContent="Height"
        CanResize="False" Topmost="True"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="22" Spacing="14">
    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="20" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button x:Name="CancelButton" IsCancel="True" />
      <Button x:Name="AcceptButton" Classes="accent" />
    </StackPanel>
  </StackPanel>
</Window>
