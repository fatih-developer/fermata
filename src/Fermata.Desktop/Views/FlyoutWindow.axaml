<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fermata.Desktop.ViewModels"
        xmlns:views="using:Fermata.Desktop.Views"
        x:Class="Fermata.Desktop.Views.FlyoutWindow"
        x:DataType="vm:MainViewModel"
        Title="Fermata"
        Width="320" SizeToContent="Height"
        WindowDecorations="None" CanResize="False" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Height" Value="6" />
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Margin" Value="6,0,8,0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
    <StackPanel Margin="16,14" Spacing="12">

      <!-- Status -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Ellipse Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center"
                 Fill="{Binding Health, Converter={x:Static views:HealthBrushConverter.Instance}}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="hint" Text="{Binding StatusDetail}" TextWrapping="Wrap"
                     IsVisible="{Binding StatusDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <Button Grid.Column="2" Name="DetailsButton" Content="Details" Padding="8,3" FontSize="12" VerticalAlignment="Center" />
      </Grid>

      <!-- Usage: label · bar · percent · resets in -->
      <Grid ColumnDefinitions="50,*,46,50" RowDefinitions="Auto,Auto" RowSpacing="8">
        <TextBlock Classes="label" Text="5-hour" />
        <ProgressBar Grid.Column="1" MinWidth="0" Value="{Binding FiveHourPercent}" Maximum="100"
                     Foreground="{Binding FiveHourPercent, Converter={x:Static views:PercentBrushConverter.Instance}}" />
        <TextBlock Grid.Column="2" Classes="value" Text="{Binding FiveHourText}" />
        <TextBlock Grid.Column="3" Classes="hint" Text="{Binding FiveHourResetsInText}" TextAlignment="Right" />

        <TextBlock Grid.Row="1" Classes="label" Text="Weekly" />
        <ProgressBar Grid.Row="1" Grid.Column="1" MinWidth="0" Value="{Binding WeeklyPercent}" Maximum="100"
                     Foreground="{Binding WeeklyPercent, Converter={x:Static views:PercentBrushConverter.Instance}}" />
        <TextBlock Grid.Row="1" Grid.Column="2" Classes="value" Text="{Binding WeeklyText}" />
        <TextBlock Grid.Row="1" Grid.Column="3" Classes="hint" Text="{Binding WeeklyResetsInText}" TextAlignment="Right" />
      </Grid>

      <!-- Jobs -->
      <StackPanel Spacing="6" IsVisible="{Binding HasJobs}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="label" Text="Jobs" />
          <TextBlock Grid.Column="1" Classes="hint" Text="{Binding JobsSummary}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Jobs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:JobRowViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="hint" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Button Content="Pause" Padding="6,2" FontSize="11" Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}" />
                  <Button Content="Resume" Padding="6,2" FontSize="11" Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Open Claude limit resets…" FontSize="12" Padding="8,3" HorizontalAlignment="Left"
                Command="{Binding OpenClaudeLimitResetsCommand}" IsVisible="{Binding ShowClaudeLimitResets}"
                ToolTip.Tip="If you have a Claude reset credit, use it on claude.ai (Limit resets, then Reset for free). Fermata cannot redeem Claude credits itself." />
      </StackPanel>

      <!-- Credits · auto-reset · reset -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Classes="label" Text="Reset credits" />
          <TextBlock Classes="value" Text="{Binding CreditsText}" />
        </StackPanel>
        <ToggleSwitch Grid.Column="1" Name="AutoResetSwitch" IsChecked="{Binding AutoReset}"
                      OnContent="Auto-reset" OffContent="Auto-reset" FontSize="12"
                      ToolTip.Tip="Use a reset credit automatically when Codex hits a limit (daily/weekly caps apply)." />
      </Grid>

      <Border CornerRadius="6" Padding="10,8" BorderBrush="#D99A1E" BorderThickness="1" IsVisible="{Binding HasPendingAttempt}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="hint" Text="A reset attempt needs attention." TextWrapping="Wrap" />
          <Button Grid.Column="1" Content="Finish" Padding="8,3" FontSize="12" Command="{Binding FinishPendingCommand}" />
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="hint" Text="{Binding LastUpdatedText}" />
        <Button Grid.Column="1" Content="Reset now…" Classes="accent" Command="{Binding ResetNowCommand}" />
      </Grid>

    </StackPanel>
  </Border>
</Window>
