<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ResetMe.Desktop.ViewModels"
        xmlns:views="using:ResetMe.Desktop.Views"
        x:Class="ResetMe.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ResetMe"
        Width="440" Height="680" MinWidth="380" MinHeight="520"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Height" Value="8" />
      <Setter Property="MinHeight" Value="8" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
  </Window.Styles>

  <ScrollViewer>
    <StackPanel Margin="20" Spacing="16">

      <!-- Status -->
      <Border CornerRadius="8" Padding="14" Background="{DynamicResource ControlFillColorDefaultBrush}">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
          <Ellipse Grid.RowSpan="2" Width="12" Height="12" Margin="0,4,12,0" VerticalAlignment="Top"
                   Fill="{Binding Health, Converter={x:Static views:HealthBrushConverter.Instance}}" />
          <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" Grid.Row="1" Classes="hint" TextWrapping="Wrap"
                     Text="{Binding StatusDetail}" IsVisible="{Binding StatusDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>
      </Border>

      <!-- Unresolved attempt -->
      <Border CornerRadius="8" Padding="14" BorderBrush="#D99A1E" BorderThickness="1" IsVisible="{Binding HasPendingAttempt}">
        <StackPanel Spacing="8">
          <TextBlock Text="Reset needs attention" FontWeight="SemiBold" />
          <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding PendingText}" />
          <Button Content="Finish pending reset" HorizontalAlignment="Right" Command="{Binding FinishPendingCommand}" />
        </StackPanel>
      </Border>

      <!-- Usage -->
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="label" Text="5-hour window" />
          <TextBlock Grid.Column="1" Classes="hint" Text="{Binding FiveHourResetText}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <ProgressBar Value="{Binding FiveHourPercent}" Maximum="100" Foreground="{Binding FiveHourPercent, Converter={x:Static views:PercentBrushConverter.Instance}}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Grid.Column="1" Classes="value" Text="{Binding FiveHourText}" MinWidth="64" TextAlignment="Right" />
        </Grid>
        <TextBlock Classes="hint" Text="{Binding FiveHourDetailText}" />
      </StackPanel>

      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="label" Text="Weekly window" />
          <TextBlock Grid.Column="1" Classes="hint" Text="{Binding WeeklyResetText}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <ProgressBar Value="{Binding WeeklyPercent}" Maximum="100" Foreground="{Binding WeeklyPercent, Converter={x:Static views:PercentBrushConverter.Instance}}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Grid.Column="1" Classes="value" Text="{Binding WeeklyText}" MinWidth="64" TextAlignment="Right" />
        </Grid>
        <TextBlock Classes="hint" Text="{Binding WeeklyDetailText}" />
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="label" Text="Reset credits" />
          <TextBlock Classes="hint" Text="{Binding CreditExpiryText}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="value" Text="{Binding CreditsText}" VerticalAlignment="Center" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Classes="hint" Text="{Binding LastUpdatedText}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Open logs" Command="{Binding OpenLogsCommand}" Margin="0,0,8,0" />
        <Button Grid.Column="2" Content="Reset now…" Classes="accent" Command="{Binding ResetNowCommand}" />
      </Grid>

      <!-- Settings -->
      <Expander Header="Settings" HorizontalAlignment="Stretch">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,160">
            <TextBlock Text="Mode" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Static vm:MainViewModel.ModeNames}" SelectedIndex="{Binding ModeIndex}" />
          </Grid>
          <TextBlock Classes="hint" TextWrapping="Wrap"
                     Text="Confirm asks before using a credit. Automatic uses one without asking (daily/weekly caps apply). Manual only informs." />
          <Grid ColumnDefinitions="*,160">
            <TextBlock Text="Check every (seconds)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Minimum="10" Maximum="3600" Increment="5" FormatString="0"
                           Value="{Binding IntervalSeconds}" />
          </Grid>
          <Grid ColumnDefinitions="*,160">
            <TextBlock Text="Skip if limit lifts within (min)" VerticalAlignment="Center" TextWrapping="Wrap" />
            <NumericUpDown Grid.Column="1" Minimum="0" Maximum="600" Increment="5" FormatString="0"
                           Value="{Binding MinNaturalResetMinutes}" />
          </Grid>
          <CheckBox Content="Desktop notifications" IsChecked="{Binding NotificationsEnabled}" />
          <CheckBox Content="{Binding NearLimitLabel}" IsChecked="{Binding NearLimitEnabled}" />
          <CheckBox Content="Start ResetMe at login" IsChecked="{Binding StartAtLogin}" />
          <CheckBox Content="Start hidden in the tray / menu bar" IsChecked="{Binding StartMinimized}" />
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="hint" Text="{Binding SettingsMessage}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="Export diagnostics" Command="{Binding ExportDiagnosticsCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="Save" Command="{Binding SaveSettingsCommand}" />
          </Grid>
        </StackPanel>
      </Expander>

      <!-- Events -->
      <StackPanel Spacing="6">
        <TextBlock Classes="label" Text="Recent events" />
        <ItemsControl ItemsSource="{Binding Events}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="hint" Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</Window>
